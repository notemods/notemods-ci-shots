     "today": "2026-10-10"
    }
   ],
   "expected": {
    "line": null,
    "task": null
   },
   "fn": "editAndParse"
  },
  {
   "name": "an empty checkbox pair is not a task",
   "args": [
    "- [] not a task",
    {
     "type": "none"
    }
   ],
   "expected": {
    "line": null,
    "task": null
   },
   "fn": "editAndParse"
  },
  {
   "name": "alternate due emoji 📆 is read and kept",
   "args": [
    "- [ ] Alt emoji 📆 2026-10-30",
    {
     "type": "date",
     "field": "due",
     "value": "2026-10-31"
    }
   ],
   "expected": {
    "line": "- [ ] Alt emoji 📆 2026-10-31",
    "task": {
