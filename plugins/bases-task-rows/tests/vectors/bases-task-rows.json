    }
   },
   "fn": "editAndParse"
  },
  {
   "name": "next date for every 7 days adds seven days to the due date",
   "args": [
    "every 7 days",
    "2026-10-12"
   ],
   "expected": "2026-10-19",
   "fn": "nextRecurrenceDate"
  },
  {
   "name": "next date for every 2 weeks adds fourteen days",
   "args": [
    "every 2 weeks",
    "2026-10-12"
   ],
   "expected": "2026-10-26",
   "fn": "nextRecurrenceDate"
  },
  {
   "name": "next date for every month keeps the day and clamps to the last day",
   "args": [
    "every month",
    "2026-01-31"
   ],
   "expected": "2026-02-28",
   "fn": "nextRecurrenceDate"
  },
  {
   "name": "next date for every 3 months adds three months",
   "args": [
    "every 3 months",
    "2026-10-12"
   ],
   "expected": "2027-01-12",
   "fn": "nextRecurrenceDate"
  },
  {
   "name": "next date for every year adds one year",
   "args": [
    "every year",
    "2024-02-29"
   ],
   "expected": "2025-02-28",
   "fn": "nextRecurrenceDate"
  },
  {
   "name": "next date for a weekday name moves to the next monday",
   "args": [
    "every monday",
    "2026-10-12"
   ],
   "expected": "2026-10-19",
   "fn": "nextRecurrenceDate"
  },
  {
   "name": "next date for every 3 days adds three days",
   "args": [
    "every 3",
    "2026-10-12"
   ],
   "expected": "2026-10-15",
   "fn": "nextRecurrenceDate"
  },
  {
   "name": "next date for a rule the plugin cannot count returns null",
   "args": [
    "every other friday",
    "2026-10-12"
   ],
   "expected": null,
   "fn": "nextRecurrenceDate"
  },
  {
   "name": "next date with no base date returns null",
   "args": [
    "every day",
    null
   ],
   "expected": null,
   "fn": "nextRecurrenceDate"
  },
  {
   "name": "next occurrence line writes an open task with the next due date and no ids",
   "args": [
    "- [x] Water plants 🔁 every week ⏳ 2026-10-11 📅 2026-10-12 ✅ 2026-10-12 #home ^water-1",
    "2026-10-12",
    "emoji"
   ],
   "expected": "- [ ] Water plants 🔁 every week ⏳ 2026-10-18 📅 2026-10-19 #home",
   "fn": "nextOccurrenceLine"
  },
  {
   "name": "next occurrence line uses the scheduled date when there is no due date",
   "args": [
    "  - [ ] Pay rent 🔁 every month [scheduled:: 2026-10-01]",
    "2026-10-12",
    "emoji"
   ],
   "expected": "  - [ ] Pay rent 🔁 every month [scheduled:: 2026-11-01]",
   "fn": "nextOccurrenceLine"
  },
  {
   "name": "next occurrence line keeps the dataview style of the source line",
   "args": [
    "- [ ] Submit report 🔁 every 2 weeks [due:: 2026-10-12]",
    "2026-10-12",
    "dataview"
   ],
   "expected": "- [ ] Submit report 🔁 every 2 weeks [due:: 2026-10-26]",
   "fn": "nextOccurrenceLine"
  },
  {
   "name": "next occurrence line is null for a task without a rule",
   "args": [
    "- [ ] Plain task 📅 2026-10-12",
    "2026-10-12",
    "emoji"
   ],
   "expected": null,
   "fn": "nextOccurrenceLine"
  },
  {
   "name": "next occurrence line rolls a task with a future date when it is ticked early",
   "args": [
    "- [ ] Water plants 🔁 every week 📅 2026-10-20",
    "2026-10-12",
    "emoji"
   ],
   "expected": "- [ ] Water plants 🔁 every week 📅 2026-10-27",
   "fn": "nextOccurrenceLine"
  },
  {
