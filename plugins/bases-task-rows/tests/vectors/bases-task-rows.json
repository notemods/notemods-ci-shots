     "dates": {},
     "priority": 2,
     "tags": [
      "work/backend"
     ],
     "recurrence": null
    }
   },
   "fn": "editAndParse"
  },
  {
   "name": "cancelled status counts as closed",
   "args": [
    "- [-] Old idea ❌ 2026-10-02",
    {
     "type": "none"
    }
   ],
   "expected": {
    "line": "- [-] Old idea ❌ 2026-10-02",
    "task": {
     "status": "-",
     "done": true,
     "text": "Old idea",
     "dates": {
      "cancelled": "2026-10-02"
     },
     "priority": 2,
     "tags": [],
     "recurrence": null
    }
   },
   "fn": "editAndParse"
  },
  {
   "name": "a list item without a checkbox is not a task",
   "args": [
    "- just a note",
    {
