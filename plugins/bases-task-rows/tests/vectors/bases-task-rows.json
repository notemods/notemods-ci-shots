{
 "slug": "bases-task-rows",
 "module": "bases-task-rows/src/task",
 "function": "editAndParse",
 "note": "editAndParse(line, edit) applies one edit (none | done | open | date | today) to one Markdown task line and parses the result. expected = {line, task}: line is the new line (byte-identical outside the changed token; null when the input is not a task), task = {status, done, text, dates, priority 0..5 with 2 = none, tags, recurrence}. Cases with fn noteProgress: noteProgress(noteText, today) counts the tasks of one note for the Task progress view (open, done, cancelled, total, whole percent, next due date of an open task, overdue open tasks, progress cell text). Cases with fn noteTagProgress: noteTagProgress(noteText, today, tagText) counts only the tasks whose task line has a matching tag (\"#\" optional, case ignored, a parent tag matches its nested tags), gives nextTask = the text of the first open matching task in file order or null, and any = the total of every task of the note.",
 "cases": [
  {
   "name": "round trip keeps a Tasks line with priority, recurrence and block id byte for byte",
   "args": [
    "  - [ ] Water plants 🔼 🔁 every week ⏳ 2026-10-11 📅 2026-10-12 #home/garden ^water-1",
    {
     "type": "none"
    }
   ],
   "expected": {
    "line": "  - [ ] Water plants 🔼 🔁 every week ⏳ 2026-10-11 📅 2026-10-12 #home/garden ^water-1",
    "task": {
     "status": " ",
     "done": false,
     "text": "Water plants",
     "dates": {
      "due": "2026-10-12",
      "scheduled": "2026-10-11"
     },
     "priority": 3,
     "tags": [
      "home/garden"
     ],
     "recurrence": "every week"
    }
   },
   "fn": "editAndParse"
  },
  {
   "name": "tick adds a done date to a line that has a due date (auto)",
   "args": [
    "- [ ] Pay rent 📅 2026-10-12 #home",
    {
     "type": "done",
     "today": "2026-10-10"
    }
   ],
   "expected": {
    "line": "- [x] Pay rent 📅 2026-10-12 #home ✅ 2026-10-10",
    "task": {
     "status": "x",
     "done": true,
     "text": "Pay rent",
     "dates": {
      "due": "2026-10-12",
      "done": "2026-10-10"
     },
     "priority": 2,
     "tags": [
      "home"
     ],
     "recurrence": null
    }
   },
   "fn": "editAndParse"
  },
  {
   "name": "tick with done date never only flips the status character",
   "args": [
    "- [ ] Pay rent 📅 2026-10-12 #home",
    {
     "type": "done",
     "today": "2026-10-10",
     "doneDate": "never"
    }
   ],
   "expected": {
    "line": "- [x] Pay rent 📅 2026-10-12 #home",
    "task": {
     "status": "x",
     "done": true,
     "text": "Pay rent",
     "dates": {
      "due": "2026-10-12"
     },
     "priority": 2,
     "tags": [
      "home"
     ],
     "recurrence": null
    }
   },
   "fn": "editAndParse"
  },
