   ],
   "expected": {
    "line": "- [ ] Send invoice #money 📅 2026-10-15 ^inv-7",
    "task": {
     "status": " ",
     "done": false,
     "text": "Send invoice",
     "dates": {
      "due": "2026-10-15"
     },
     "priority": 2,
     "tags": [
      "money"
     ],
     "recurrence": null
    }
   },
   "fn": "editAndParse"
  },
  {
   "name": "new due date on a plain line uses the Dataview style when asked",
   "args": [
    "- [ ] Send invoice",
    {
     "type": "date",
     "field": "due",
     "value": "2026-10-15",
     "style": "dataview"
    }
   ],
   "expected": {
    "line": "- [ ] Send invoice [due:: 2026-10-15]",
    "task": {
     "status": " ",
     "done": false,
     "text": "Send invoice",
     "dates": {
      "due": "2026-10-15"
     },
     "priority": 2,
     "tags": [],
     "recurrence": null
    }
   },
   "fn": "editAndParse"
  },
  {
   "name": "move to today changes the scheduled date when there is no due date",
   "args": [
    "> - [ ] Quoted task ⏳ 2026-10-03",
    {
     "type": "today",
     "today": "2026-10-10"
    }
   ],
   "expected": {
    "line": "> - [ ] Quoted task ⏳ 2026-10-10",
    "task": {
     "status": " ",
     "done": false,
     "text": "Quoted task",
     "dates": {
      "scheduled": "2026-10-10"
     },
     "priority": 2,
     "tags": [],
     "recurrence": null
    }
   },
   "fn": "editAndParse"
  },
  {
   "name": "move to today adds a due date to an undated task",
   "args": [
    "1. [ ] Numbered task #errand",
    {
     "type": "today",
     "today": "2026-10-10"
    }
   ],
   "expected": {
    "line": "1. [ ] Numbered task #errand 📅 2026-10-10",
    "task": {
     "status": " ",
     "done": false,
     "text": "Numbered task",
     "dates": {
      "due": "2026-10-10"
     },
     "priority": 2,
     "tags": [
      "errand"
     ],
     "recurrence": null
    }
   },
   "fn": "editAndParse"
  },
  {
   "name": "tags skip pure numbers and code spans",
   "args": [
    "- [ ] Fix bug #123 in `#notatag` for #work/backend",
