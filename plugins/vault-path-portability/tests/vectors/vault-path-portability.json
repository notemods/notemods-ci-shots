{
 "slug": "vault-path-portability",
 "module": "products/vault-path-portability/src/scan.ts",
 "function": "scanPaths",
 "cases": [
  {
   "name": "case collision",
   "args": [
    [
     "Note.md",
     "note.md"
    ]
   ],
   "expected": [
    {
     "rule": "case-collision",
     "paths": [
      "Note.md",
      "note.md"
     ]
    }
   ]
  },
  {
   "name": "reserved CON.md",
   "args": [
    [
     "CON.md"
    ]
   ],
   "expected": [
    {
     "rule": "reserved-name",
     "paths": [
      "CON.md"
     ]
    }
   ]
  },
  {
   "name": "reserved prn.txt",
   "args": [
    [
     "prn.txt"
    ]
   ],
   "expected": [
    {
     "rule": "reserved-name",
     "paths": [
      "prn.txt"
     ]
    }
   ]
  },
  {
   "name": "reserved AUX",
   "args": [
    [
     "AUX"
    ]
   ],
   "expected": [
    {
     "rule": "reserved-name",
     "paths": [
      "AUX"
     ]
    }
   ]
  },
  {
   "name": "reserved nul.md",
   "args": [
    [
     "nul.md"
    ]
   ],
   "expected": [
