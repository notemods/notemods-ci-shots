{
 "slug": "vimwiki-import",
 "module": "vimwiki-import/src/importer",
 "function": "planImport",
 "cases": [
  {
   "name": "Heading levels one and two",
   "args": [
    [
     {
      "path": "Wiki/page.wiki",
      "text": "= Title =\n== Part =="
     }
    ],
    {
     "source": "Wiki",
     "destination": "Notes"
    }
   ],
   "expected": {
    "options": {
     "source": "Wiki",
     "destination": "Notes"
    },
    "pages": [
     {
      "path": "Wiki/page.wiki",
      "text": "= Title =\n== Part ==",
      "output": "Notes/page.md",
      "markdown": "# Title\n## Part"
     }
    ],
    "issues": []
   }
  },
  {
   "name": "Labeled local link",
   "args": [
    [
     {
      "path": "Wiki/page.wiki",
      "text": "[[b|Label]]"
     },
     {
      "path": "Wiki/b.wiki",
      "text": "B"
     }
    ],
    {
     "source": "Wiki",
     "destination": "Notes"
    }
   ],
   "expected": {
    "options": {
     "source": "Wiki",
     "destination": "Notes"
    },
    "pages": [
     {
      "path": "Wiki/b.wiki",
      "text": "B",
      "output": "Notes/b.md",
      "markdown": "B"
     },
     {
      "path": "Wiki/page.wiki",
      "text": "[[b|Label]]",
      "output": "Notes/page.md",
      "markdown": "[[Notes/b|Label]]"
     }
    ],
    "issues": []
   }
  },
  {
   "name": "Parent link uses source directory",
   "args": [
    [
     {
      "path": "Wiki/folder/a.wiki",
      "text": "[[../b]]"
     },
     {
      "path": "Wiki/b.wiki",
      "text": "B"
     }
    ],
    {
     "source": "Wiki",
     "destination": "Notes"
    }
   ],
   "expected": {
    "options": {
     "source": "Wiki",
     "destination": "Notes"
    },
    "pages": [
     {
      "path": "Wiki/b.wiki",
      "text": "B",
      "output": "Notes/b.md",
      "markdown": "B"
     },
     {
      "path": "Wiki/folder/a.wiki",
      "text": "[[../b]]",
      "output": "Notes/folder/a.md",
      "markdown": "[[Notes/b|../b]]"
     }
    ],
    "issues": []
   }
  },
  {
   "name": "External link is Markdown",
