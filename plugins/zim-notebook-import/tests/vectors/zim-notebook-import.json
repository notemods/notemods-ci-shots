    "Source",
    "Output",
    []
   ],
   "expected": {
    "notes": [
     {
      "source": "Source/Page.txt",
      "path": "Output/Page.md",
      "body": "# Title",
      "properties": {
       "zim_source": "Source/Page.txt",
       "zim_created": "2020-05-02T12:30:00+00:00"
      }
     }
    ],
    "issues": [],
    "conflicts": []
   }
  },
