{
 "slug": "secret-parcel",
 "module": "secret-parcel/src/parcel",
 "function": "validatePayload",
 "note": "args starts with an operation. The product vector test runs cryptographic and storage scenarios with an in-memory keychain. No live keys are used.",
 "cases": [
  {
   "name": "selected secrets round trip and no plaintext",
   "args": [
    "roundtrip",
    {
     "entries": [
      {
       "id": "openai-key",
       "value": "sk-sample-only"
      },
      {
       "id": "github-token",
       "value": "ghp_sample-only"
      }
     ]
    }
   ],
   "expected": {
    "identical": true,
    "hidden": true,
    "v": 1,
    "iterations": 310000,
    "saltBytes": 16,
    "ivBytes": 12
   }
  },
  {
   "name": "empty passphrase is refused",
   "args": [
    "pass",
    ""
   ],
   "expected": "Passphrase must have 8 or more characters."
  },
  {
   "name": "short passphrase is refused",
   "args": [
    "pass",
    "1234567"
   ],
   "expected": "Passphrase must have 8 or more characters."
  },
  {
   "name": "eight character passphrase accepted",
   "args": [
    "pass",
    "12345678"
   ],
   "expected": "ok"
  },
  {
   "name": "no selected IDs cannot export",
   "args": [
    "selection",
    []
   ],
   "expected": false
  },
  {
   "name": "empty keychain has no modal",
   "args": [
    "selection",
    []
   ],
   "expected": false
  },
  {
   "name": "import into empty keychain",
   "args": [
    "write",
    {
     "entries": [
      {
       "id": "openai-key",
       "value": "sk-sample-only"
      },
      {
       "id": "github-token",
       "value": "ghp_sample-only"
      }
     ]
    },
    {},
    []
   ],
   "expected": {
    "written": [
     "openai-key",
     "github-token"
    ],
    "skipped": [],
    "failed": []
   }
  },
  {
   "name": "wrong passphrase authenticates nothing",
   "args": [
    "wrong",
    {
     "entries": [
      {
       "id": "openai-key",
       "value": "sk-sample-only"
      },
      {
       "id": "github-token",
       "value": "ghp_sample-only"
      }
     ]
    }
   ],
   "expected": "Wrong passphrase or damaged file."
  },
  {
   "name": "changed ciphertext authenticates nothing",
   "args": [
    "tamper",
    {
     "entries": [
      {
       "id": "openai-key",
       "value": "sk-sample-only"
      },
      {
       "id": "github-token",
       "value": "ghp_sample-only"
      }
     ]
    }
   ],
   "expected": "Wrong passphrase or damaged file."
  },
  {
   "name": "preview identifies default conflict",
   "args": [
    "preview",
    {
     "entries": [
      {
       "id": "openai-key",
       "value": "sk-sample-only"
      },
      {
       "id": "github-token",
       "value": "ghp_sample-only"
      }
     ]
    },
    {
     "github-token": "old"
    }
   ],
   "expected": {
    "newIds": [
     "openai-key"
    ],
    "conflicts": [
     "github-token"
    ]
   }
  },
  {
   "name": "conflicting ID stays unchanged by default",
   "args": [
    "write",
    {
     "entries": [
      {
       "id": "openai-key",
       "value": "sk-sample-only"
      },
      {
       "id": "github-token",
       "value": "ghp_sample-only"
      }
     ]
    },
    {
     "github-token": "old"
    },
    []
   ],
   "expected": {
    "written": [
     "openai-key"
    ],
    "skipped": [
     "github-token"
    ],
    "failed": []
   }
  },
  {
   "name": "explicit overwrite writes conflict",
   "args": [
    "write",
    {
     "entries": [
      {
       "id": "openai-key",
       "value": "sk-sample-only"
      },
      {
       "id": "github-token",
       "value": "ghp_sample-only"
      }
     ]
    },
    {
     "github-token": "old"
    },
    [
     "github-token"
    ]
   ],
   "expected": {
    "written": [
     "openai-key",
     "github-token"
    ],
    "skipped": [],
    "failed": []
   }
  },
  {
   "name": "invalid ID refuses entire payload",
   "args": [
    "validate",
    {
     "entries": [
      {
       "id": "openai-key",
       "value": "sk-sample-only"
      },
      {
       "id": "Bad ID!",
       "value": "x"
      }
     ]
    }
   ],
   "expected": "Invalid entry 2: ID must use lowercase letters, digits or dashes (1 to 128 characters)."
  },
  {
   "name": "duplicate ID refuses entire payload",
   "args": [
    "validate",
    {
     "entries": [
      {
       "id": "openai-key",
       "value": "sk-sample-only"
      },
      {
       "id": "openai-key",
       "value": "sk-sample-only"
      }
     ]
    }
   ],
   "expected": "Invalid entry 2 (openai-key): duplicate ID."
  },
  {
   "name": "more than 500 entries refused",
   "args": [
    "count",
    501
   ],
   "expected": "Invalid entry 501: more than 500 entries."
  },
  {
   "name": "value over 64 KB refused",
   "args": [
    "size",
    65537
   ],
   "expected": "Invalid entry 1 (key): value exceeds 64 KB."
  },
  {
   "name": "value of 64 KB accepted",
   "args": [
    "size",
    65536
   ],
   "expected": "ok"
  },
  {
   "name": "unicode byte size is enforced",
   "args": [
    "unicode",
    32769
   ],
   "expected": "Invalid entry 1 (key): value exceeds 64 KB."
  },
  {
   "name": "random salt and IV differ",
   "args": [
    "random",
    {
     "entries": [
      {
       "id": "openai-key",
       "value": "sk-sample-only"
      },
      {
       "id": "github-token",
       "value": "ghp_sample-only"
      }
     ]
    }
   ],
   "expected": {
    "saltDiffers": true,
    "ivDiffers": true
   }
  },
  {
   "name": "prefix profile selects only matching IDs",
   "args": [
    "filter",
    [
     "openai-key",
     "github-token",
     "openai-test"
    ],
    "openai-"
   ],
   "expected": [
    "openai-key",
    "openai-test"
   ]
  },
  {
   "name": "comparison uses hashes and lists missing IDs",
   "args": [
    "compare",
    {
     "entries": [
      {
       "id": "openai-key",
       "value": "sk-sample-only"
      },
      {
       "id": "github-token",
       "value": "ghp_sample-only"
      }
     ]
    },
    {
     "github-token": "old",
     "extra-key": "extra"
    }
   ],
   "expected": {
    "newIds": [
     "openai-key"
    ],
    "missing": [
     "extra-key"
    ],
    "changed": [
     "github-token"
    ],
    "unchanged": []
   }
  },
  {
   "name": "comparison marks equal value unchanged",
   "args": [
    "compare",
    {
     "entries": [
      {
       "id": "openai-key",
       "value": "sk-sample-only"
      }
     ]
    },
    {
     "openai-key": "sk-sample-only"
    }
   ],
   "expected": {
    "newIds": [],
    "missing": [],
    "changed": [],
    "unchanged": [
     "openai-key"
    ]
   }
  },
  {
   "name": "non text value refused",
   "args": [
    "validate",
    {
     "entries": [
      {
       "id": "key",
       "value": 42
      }
     ]
    }
   ],
   "expected": "Invalid entry 1 (key): value must be text."
  },
  {
   "name": "missing entries refused",
   "args": [
    "validate",
    {}
   ],
   "expected": "Invalid payload: entries must be a list."
  },
  {
   "name": "empty secret value supported",
   "args": [
    "write",
    {
     "entries": [
      {
       "id": "empty",
       "value": ""
      }
     ]
    },
    {},
    []
   ],
   "expected": {
    "written": [
     "empty"
    ],
    "skipped": [],
    "failed": []
   }
  },
  {
   "name": "relative folder refused",
   "args": [
    "folder",
    "../private"
   ],
   "expected": "Choose a normal vault folder. Hidden folders and relative paths are not allowed."
  },
  {
   "name": "normal nested folder accepted",
   "args": [
    "folder",
    "Secret Parcels/Work"
   ],
   "expected": "Secret Parcels/Work"
  },
  {
   "name": "four Unicode characters are a short passphrase",
   "args": [
    "pass",
    "🔐🔐🔐🔐"
   ],
   "expected": "Passphrase must have 8 or more characters."
  },
  {
   "name": "short wrong import passphrase gives the authentication notice",
   "args": [
    "wrong-short",
    {
     "entries": [
      {
       "id": "key",
       "value": "sample"
      }
     ]
    }
   ],
   "expected": "Wrong passphrase or damaged file."
  }
 ]
}
