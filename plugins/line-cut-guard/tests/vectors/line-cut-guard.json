{
 "slug": "line-cut-guard",
 "module": "line-cut-guard/src/guard",
 "function": "step",
 "note": "Each case names its function in fn. step(input) decides pass or stop for one cut or copy, the next pending first press and the notice. nothingSelected(ranges, marked). effectiveMode(mode, pro). mayNotify(lastShown, now, message). noticeText(kind, message, mod). shortcutKind(code, key, ctrl, meta, alt, shift, mac). lineRanges(doc, cursors, lineBreak) follows copiedRange of @codemirror/view. Names that start with A1 to A8 are the acceptance criteria of lanes/NEW/SPEC.md. Expected values written by hand from SPEC R1 to R5 and the CodeMirror rule.",
 "cases": [
  {
   "name": "A1 cut with nothing selected is stopped",
   "fn": "step",
   "args": [
    {
     "kind": "cut",
     "mode": "block",
     "pro": false,
     "nothingSelected": true,
     "token": "e1:1",
     "now": 1000,
     "repeat": false,
     "pending": null
    }
   ],
   "expected": {
    "action": "stop",
    "pending": null,
    "message": "stopped"
   }
  },
  {
