     "key": "[[\"status\",\"\\\"A\\\"\"]]",
     "label": "A",
     "property": "status",
     "count": 2,
     "summary": null,
     "rows": [
      "b",
      "a"
     ],
     "children": []
    }
   ]
  },
  {
