       "rows": [
        "a"
       ],
       "children": [
        {
         "key": "[[\"status\",\"\\\"A\\\"\"],[\"project\",\"\\\"B\\\"\"],[\"area\",\"\\\"C\\\"\"]]",
         "label": "C",
         "property": "area",
         "count": 1,
         "summary": 4,
         "rows": [
          "a"
         ],
         "children": []
        }
       ]
      }
