{
 "slug": "bases-multi-group",
 "module": "bases-multi-group/src/group",
 "function": "buildGroups",
 "cases": [
  {
   "name": "two nested properties",
   "args": [
    [
     {
      "id": "a",
      "values": {
       "status": "Todo",
       "project": "Alpha"
      }
     },
     {
      "id": "b",
      "values": {
       "status": "Todo",
       "project": "Beta"
      }
     }
    ],
    {
     "properties": [
      "status",
      "project"
     ],
     "splitLists": false,
     "pro": false
    }
   ],
   "expected": [
    {
     "key": "[[\"status\",\"\\\"Todo\\\"\"]]",
     "label": "Todo",
     "property": "status",
     "count": 2,
     "summary": null,
     "rows": [
      "a",
      "b"
     ],
     "children": [
      {
       "key": "[[\"status\",\"\\\"Todo\\\"\"],[\"project\",\"\\\"Alpha\\\"\"]]",
       "label": "Alpha",
       "property": "project",
       "count": 1,
       "summary": null,
       "rows": [
        "a"
       ],
       "children": []
      },
      {
       "key": "[[\"status\",\"\\\"Todo\\\"\"],[\"project\",\"\\\"Beta\\\"\"]]",
       "label": "Beta",
       "property": "project",
       "count": 1,
       "summary": null,
       "rows": [
        "b"
       ],
       "children": []
      }
     ]
    }
   ]
  },
  {
   "name": "list stays combined",
   "args": [
    [
     {
      "id": "a",
      "values": {
       "status": [
        "A",
        "B"
       ]
      }
     }
    ],
    {
     "properties": [
      "status"
     ],
     "splitLists": false,
     "pro": false
    }
   ],
   "expected": [
    {
     "key": "[[\"status\",\"[\\\"A\\\",\\\"B\\\"]\"]]",
     "label": "[A, B]",
     "property": "status",
     "count": 1,
     "summary": null,
     "rows": [
      "a"
     ],
     "children": []
    }
   ]
  },
  {
   "name": "list splits across groups",
   "args": [
    [
     {
      "id": "a",
      "values": {
       "status": [
        "A",
        "B"
       ]
      }
     }
    ],
    {
     "properties": [
      "status"
     ],
     "splitLists": true,
     "pro": false
    }
   ],
   "expected": [
    {
     "key": "[[\"status\",\"\\\"A\\\"\"]]",
     "label": "A",
     "property": "status",
     "count": 1,
     "summary": null,
     "rows": [
      "a"
     ],
     "children": []
    },
    {
     "key": "[[\"status\",\"\\\"B\\\"\"]]",
     "label": "B",
     "property": "status",
     "count": 1,
     "summary": null,
     "rows": [
      "a"
     ],
     "children": []
    }
   ]
  },
  {
   "name": "list duplicates count once",
   "args": [
    [
     {
      "id": "a",
      "values": {
       "status": [
        "A",
        "A"
       ]
      }
     }
    ],
    {
     "properties": [
      "status"
     ],
     "splitLists": true,
     "pro": false
    }
   ],
   "expected": [
    {
     "key": "[[\"status\",\"\\\"A\\\"\"]]",
     "label": "A",
     "property": "status",
     "count": 1,
     "summary": null,
     "rows": [
      "a"
     ],
     "children": []
    }
   ]
  },
  {
   "name": "missing and empty lists",
   "args": [
    [
     {
      "id": "a",
      "values": {}
     },
     {
      "id": "b",
      "values": {
       "status": []
      }
     }
    ],
    {
     "properties": [
      "status"
     ],
     "splitLists": true,
     "pro": false
    }
   ],
   "expected": [
    {
     "key": "[[\"status\",\"null\"]]",
     "label": "(no value)",
     "property": "status",
     "count": 2,
     "summary": null,
     "rows": [
      "a",
      "b"
     ],
     "children": []
    }
   ]
  },
  {
   "name": "leaf row order",
   "args": [
    [
     {
      "id": "b",
      "values": {
       "status": "A"
      }
     },
     {
      "id": "a",
      "values": {
       "status": "A"
      }
     }
    ],
    {
     "properties": [
      "status"
     ],
     "splitLists": false,
