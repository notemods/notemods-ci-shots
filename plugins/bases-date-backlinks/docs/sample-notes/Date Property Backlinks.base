# Generated by Date Property Backlinks
dateBacklinksManaged: true

filters:
  and:
    - 'file.ext == "md"'
    - 'formula.dateBacklinksHasDate'

formulas:
  dateBacklinksHasDate: 'note["date"] != null'

views:
  - type: bases-date-backlinks
    name: Date backlinks
    matchProperty: note.date
    dailyNoteDate: file.name
    dailyNoteFormat: YYYY-MM-DD
    rollupPeriod: day
    additionalProperties:
      - note.meeting_date
    rangeStart: note.start
    rangeEnd: note.end
