 "function": "parseQuestions",
 "cases": [
  {
   "name": "Two questions with answers",
   "function": "parseQuestions",
   "args": [
    "What is ATP?\nEnergy carrier\n\nWhat is DNA?\nGenetic code"
   ],
   "expected": [
    {
     "path": "",
     "line": 0,
     "question": "What is ATP?",
     "answer": "Energy carrier",
     "mark": null
    },
    {
     "path": "",
     "line": 3,
     "question": "What is DNA?",
     "answer": "Genetic code",
     "mark": null
    }
   ]
  },
  {
   "name": "Question in fenced code is excluded",
   "function": "parseQuestions",
   "args": [
    "```js\nwhat?\n```\n\nReal?\nyes"
   ],
   "expected": [
    {
     "path": "",
     "line": 4,
     "question": "Real?",
     "answer": "yes",
     "mark": null
    }
   ]
  },
  {
   "name": "Question without an answer",
   "function": "parseQuestions",
   "args": [
    "Empty?\n\nNext?\na"
   ],
   "expected": [
    {
     "path": "",
     "line": 0,
     "question": "Empty?",
     "answer": "",
     "mark": null
    },
    {
     "path": "",
     "line": 2,
     "question": "Next?",
     "answer": "a",
     "mark": null
    }
   ]
  },
  {
   "name": "Empty answer display",
   "function": "answerText",
   "args": [
    ""
   ],
   "expected": "(no answer)"
  },
  {
