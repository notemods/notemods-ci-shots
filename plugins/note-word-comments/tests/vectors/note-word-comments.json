     "author": "Lee"
    }
   ],
   "expected": {
    "body": [
     "Use snake_case names and 5 * 3 math."
    ],
    "comments": [],
    "problems": []
   }
  },
  {
   "name": "A hash tag line is plain text",
   "args": [
    "#tag at the start",
    {
     "author": "Lee"
    }
   ],
   "expected": {
    "body": [
     "#tag at the start"
    ],
    "comments": [],
    "problems": []
   }
  },
  {
   "name": "Note embed and HTML comment are unsupported",
   "args": [
    "Intro.\n\n![[Other note]]\n\nText <!-- hidden --> here.",
