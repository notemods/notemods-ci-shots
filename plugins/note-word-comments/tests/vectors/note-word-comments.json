    "comments": [],
    "problems": []
   }
  },
  {
   "name": "Pro: image from a web address is unsupported",
   "args": [
    "![x](https://example.com/a.png)",
    {
     "author": "Lee",
     "pro": true
    }
   ],
   "expected": {
    "body": [],
    "comments": [],
    "problems": [
     "line 1: image from a web address"
    ]
   }
  },
  {
   "name": "Pro: author labels",
   "args": [
    "Claim %% Lee: add a source %% and more %% Sam Ortiz: reword %% end %% plain %%.",
    {
     "author": "Lee",
     "pro": true,
     "labels": true
    }
   ],
   "expected": {
    "body": [
     "Claim and more end."
    ],
    "comments": [
     {
      "id": 0,
      "author": "Lee",
      "text": "add a source",
      "anchor": "Claim"
     },
     {
      "id": 1,
      "author": "Sam Ortiz",
      "text": "reword",
      "anchor": "more"
     },
     {
      "id": 2,
      "author": "Lee",
      "text": "plain",
      "anchor": "end"
     }
    ],
    "problems": []
   }
  },
  {
   "name": "Labels off: label stays in the comment text",
   "args": [
    "Claim %% Lee: add a source %%.",
    {
     "author": "Lee",
     "pro": true
    }
   ],
   "expected": {
    "body": [
     "Claim."
    ],
    "comments": [
     {
      "id": 0,
