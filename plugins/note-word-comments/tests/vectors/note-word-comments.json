    ],
    "comments": [
     {
      "id": 0,
      "author": "Lee",
      "text": "check numbers",
      "anchor": "Results"
     }
    ],
    "problems": []
   }
  },
  {
   "name": "Front matter is not exported",
   "args": [
    "---\ntags: draft\n---\nBody %% c %%.",
    {
     "author": "Lee"
    }
   ],
   "expected": {
    "body": [
     "Body."
    ],
    "comments": [
     {
      "id": 0,
      "author": "Lee",
      "text": "c",
      "anchor": "Body"
     }
    ],
    "problems": []
   }
  },
  {
   "name": "List and block quote are unsupported",
   "args": [
    "- item\n\n> quote",
    {
     "author": "Lee"
    }
   ],
   "expected": {
    "body": [],
    "comments": [],
    "problems": [
     "line 1: list",
     "line 3: block quote or callout"
    ]
   }
  },
  {
   "name": "Comment ids continue from firstId",
   "args": [
    "One %% a %% two %% b %%.",
    {
     "author": "Lee",
     "firstId": 5
    }
   ],
   "expected": {
    "body": [
     "One two."
    ],
    "comments": [
     {
      "id": 5,
      "author": "Lee",
      "text": "a",
      "anchor": "One"
     },
     {
      "id": 6,
      "author": "Lee",
      "text": "b",
      "anchor": "two"
     }
    ],
    "problems": []
   }
  },
  {
   "name": "Line numbers count comments that span lines",
   "args": [
    "Word %% a\nb %%\nNext\n\n```",
    {
     "author": "Lee"
    }
   ],
   "expected": {
    "body": [
     "Word\nNext"
    ],
    "comments": [
     {
      "id": 0,
      "author": "Lee",
      "text": "a b",
      "anchor": "Word"
     }
    ],
    "problems": [
     "line 5: fenced code block"
    ]
   }
  },
  {
   "name": "Pro: table with a comment in a cell",
   "args": [
    "| Item | Cost |\n| --- | ---: |\n| Rent %% check %% | 900 |",
    {
     "author": "Lee",
     "pro": true
    }
   ],
   "expected": {
    "body": [
     "| Item | Cost |\n| Rent | 900 |"
    ],
    "comments": [
     {
      "id": 0,
      "author": "Lee",
      "text": "check",
      "anchor": "Rent"
     }
    ],
    "problems": []
   }
  },
  {
   "name": "Pro: local image on its own line",
   "args": [
    "Intro.\n\n![[chart.png|300]]\n\n![Plan](images/plan.jpg)",
