{
 "slug": "note-word-comments",
 "module": "products/note-word-comments/src/parse.ts",
 "function": "summarizeNote",
 "cases": [
  {
   "name": "Case 1: comment on the previous word with author Lee",
   "args": [
    "We need evidence %% add a source %%.",
    {
     "author": "Lee"
    }
   ],
   "expected": {
    "body": [
     "We need evidence."
    ],
    "comments": [
     {
      "id": 0,
      "author": "Lee",
      "text": "add a source",
      "anchor": "evidence"
     }
    ],
    "problems": []
   }
  },
  {
   "name": "Case 2: one heading and one paragraph, no comments",
   "args": [
    "# Draft\n\nPlain text.",
    {
     "author": "Lee"
    }
   ],
   "expected": {
    "body": [
     "# Draft",
     "Plain text."
    ],
    "comments": [],
    "problems": []
   }
  },
  {
   "name": "Case 3: Greek anchor and XML characters in the comment",
   "args": [
    "αβ %% Check < & > %%.",
    {
     "author": "Lee"
    }
   ],
   "expected": {
    "body": [
     "αβ."
    ],
    "comments": [
     {
      "id": 0,
      "author": "Lee",
      "text": "Check < & >",
      "anchor": "αβ"
     }
    ],
    "problems": []
   }
  },
  {
   "name": "Case 4: two comments on one word",
   "args": [
    "Word %% first %% %% second %%.",
    {
     "author": "Lee"
    }
   ],
   "expected": {
    "body": [
     "Word."
    ],
    "comments": [
     {
      "id": 0,
      "author": "Lee",
      "text": "first",
      "anchor": "Word"
     },
     {
      "id": 1,
      "author": "Lee",
      "text": "second",
      "anchor": "Word"
     }
    ],
    "problems": []
   }
  },
  {
   "name": "Case 5: comment at the start of a paragraph is an error",
   "args": [
    "%% first %% Word.",
    {
     "author": "Lee"
    }
   ],
   "expected": {
    "body": [
     " Word."
    ],
    "comments": [],
    "problems": [
     "line 1: no previous word in this paragraph"
    ]
   }
  },
  {
   "name": "Case 6: comment that crosses a paragraph is an error",
   "args": [
    "Word %% first\n\nsecond %%.",
    {
     "author": "Lee"
    }
   ],
   "expected": {
    "body": [
     "Word."
    ],
    "comments": [
     {
      "id": 0,
      "author": "Lee",
      "text": "first second",
      "anchor": "Word"
     }
    ],
    "problems": [
     "line 1: comment crosses a paragraph"
    ]
   }
  },
  {
   "name": "Case 7: empty comment is an error",
   "args": [
    "Word %% %%.",
    {
     "author": "Lee"
    }
   ],
   "expected": {
    "body": [
     "Word."
    ],
    "comments": [],
    "problems": [
     "line 1: empty comment"
    ]
   }
  },
  {
   "name": "Case 8a: fenced code block is unsupported",
   "args": [
    "Text %% c %%.\n\n```js\nlet a = 1;\n```",
    {
     "author": "Lee"
    }
   ],
   "expected": {
    "body": [
     "Text."
    ],
    "comments": [
     {
      "id": 0,
      "author": "Lee",
      "text": "c",
      "anchor": "Text"
     }
    ],
    "problems": [
     "line 3: fenced code block"
    ]
   }
  },
  {
   "name": "Case 8b: Markdown table is Pro",
   "args": [
    "| a | b |\n| --- | --- |\n| 1 | 2 |",
    {
     "author": "Lee"
    }
   ],
   "expected": {
    "body": [],
    "comments": [],
    "problems": [
     "line 1: Markdown table (Pro)"
    ]
   }
  },
  {
   "name": "Case 8c: image is Pro",
   "args": [
    "Intro.\n\n![[chart.png]]",
    {
     "author": "Lee"
    }
   ],
   "expected": {
    "body": [
     "Intro."
    ],
    "comments": [],
    "problems": [
     "line 3: image (Pro)"
    ]
   }
  },
  {
   "name": "Case 8d: bold and italic text are unsupported",
   "args": [
    "Some **bold** and *italic* words.",
    {
     "author": "Lee"
    }
   ],
   "expected": {
    "body": [
     "Some **bold** and *italic* words."
    ],
    "comments": [],
    "problems": [
     "line 1: bold text",
     "line 1: italic text"
    ]
   }
  },
  {
   "name": "Case 8e: inline code and links are unsupported",
   "args": [
    "Use `code` and [[Other note]] and [site](https://example.com).",
    {
     "author": "Lee"
    }
   ],
   "expected": {
    "body": [
     "Use `code` and [[Other note]] and [site](https://example.com)."
    ],
    "comments": [],
    "problems": [
     "line 1: internal link",
     "line 1: Markdown link",
     "line 1: inline code"
    ]
   }
  },
  {
   "name": "Comment without a closing marker is an error",
   "args": [
    "Word %% open comment.",
    {
     "author": "Lee"
    }
   ],
   "expected": {
    "body": [
     "Word  open comment."
    ],
    "comments": [],
    "problems": [
     "line 1: comment has no closing %%"
    ]
   }
  },
  {
   "name": "Comment after punctuation marks the word without the comma",
   "args": [
    "First, %% why %% then more.",
    {
     "author": "Lee"
    }
   ],
   "expected": {
    "body": [
     "First, then more."
    ],
    "comments": [
     {
      "id": 0,
      "author": "Lee",
      "text": "why",
      "anchor": "First"
     }
    ],
    "problems": []
   }
  },
  {
   "name": "Comment on the second line of a paragraph",
   "args": [
    "Line one\nline two %% note %%",
    {
     "author": "Lee"
    }
   ],
   "expected": {
    "body": [
     "Line one\nline two"
    ],
    "comments": [
     {
      "id": 0,
      "author": "Lee",
      "text": "note",
      "anchor": "two"
     }
    ],
    "problems": []
   }
  },
  {
   "name": "Comment in a heading",
   "args": [
    "## Results %% check numbers %%\n\nBody.",
    {
     "author": "Lee"
    }
   ],
   "expected": {
    "body": [
     "## Results",
