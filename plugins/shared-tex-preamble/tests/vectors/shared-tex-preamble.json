{
 "slug": "shared-tex-preamble",
 "module": "shared-tex-preamble/src/preamble",
 "function": "parsePreamble",
 "note": "Each case calls the export of src/preamble named in \"function\" with args and compares the result. \"acceptance\" names the BRIEF.md acceptance case (A1 to A8) or \"core\". For expand and sampleCall, the last argument is the library source: the test parses it with parsePreamble and passes its defs. expand expected is {text, error}, or {error} alone when the expansion stops.",
 "cases": [
  {
   "name": "case 1: one newcommand with one argument",
   "acceptance": "A1",
   "function": "parsePreamble",
   "args": [
    "\\newcommand{\\Vcheck}[1]{#1+7}"
   ],
   "expected": {
    "defs": [
     {
      "name": "Vcheck",
      "kind": "newcommand",
      "args": 1,
      "optional": null,
      "body": "#1+7",
      "source": "\\newcommand{\\Vcheck}[1]{#1+7}",
      "line": 1
     }
    ],
    "errors": [],
    "blocked": []
   }
  },
  {
   "name": "case 1: the sample call expands to 2+7",
   "acceptance": "A1",
   "function": "expand",
   "args": [
    "\\Vcheck{2}",
    "\\newcommand{\\Vcheck}[1]{#1+7}"
   ],
   "expected": {
    "text": "2+7",
    "error": null
   }
  },
  {
   "name": "case 2: a Markdown macro file keeps the definition in a $$ block",
   "acceptance": "A2",
   "function": "extractTex",
   "args": [
    "---\ntags: tex\n---\n# Macros\n\n$$\n\\newcommand{\\Vcheck}[1]{#1+7}\n$$\n\nText that is not TeX.",
    "md"
   ],
   "expected": "\n\n\n\n\n\n\\newcommand{\\Vcheck}[1]{#1+7}\n\n\n"
  },
  {
   "name": "case 2: the TeX part of a Markdown file parses with its file line number",
   "acceptance": "A2",
   "function": "parsePreamble",
   "args": [
    "\n\n\n\n\n\n\\newcommand{\\Vcheck}[1]{#1+7}\n\n\n"
   ],
   "expected": {
    "defs": [
     {
      "name": "Vcheck",
      "kind": "newcommand",
      "args": 1,
      "optional": null,
      "body": "#1+7",
      "source": "\\newcommand{\\Vcheck}[1]{#1+7}",
      "line": 7
     }
    ],
    "errors": [],
    "blocked": []
   }
  },
  {
   "name": "case 3: renewcommand replaces the body",
   "acceptance": "A3",
   "function": "parsePreamble",
   "args": [
    "\\renewcommand{\\Vcheck}[1]{#1+8}"
   ],
   "expected": {
    "defs": [
     {
      "name": "Vcheck",
      "kind": "renewcommand",
      "args": 1,
      "optional": null,
      "body": "#1+8",
      "source": "\\renewcommand{\\Vcheck}[1]{#1+8}",
      "line": 1
     }
    ],
    "errors": [],
    "blocked": []
   }
  },
  {
   "name": "case 3: after the change, the sample expands to 2+8",
   "acceptance": "A3",
   "function": "expand",
   "args": [
    "\\Vcheck{2}",
    "\\newcommand{\\Vcheck}[1]{#1+7}\n\\renewcommand{\\Vcheck}[1]{#1+8}"
   ],
   "expected": {
    "text": "2+8",
    "error": null
   }
  },
  {
   "name": "case 4: a .tex path is a macro file type",
