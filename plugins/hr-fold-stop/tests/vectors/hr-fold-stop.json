    true
   ],
   "expected": {
    "stop": 4,
    "kind": "marker"
   }
  },
  {
   "name": "marker 20 three spaces before a level 2 marker",
   "args": [
    "## A\nBody\n\n   %% fold-stop 2 %%\nTail",
    1,
    2,
    true
   ],
   "expected": {
    "stop": 4,
    "kind": "marker"
   }
  },
  {
   "name": "marker 21 digit 7 is not a marker",
   "args": [
    "## A\nBody\n\n%% fold-stop 7 %%\nTail",
    1,
    2,
    true
   ],
   "expected": {
    "stop": null,
    "kind": null
   }
  },
  {
   "name": "marker 22 a word after fold-stop is not a marker",
   "args": [
    "## A\nBody\n\n%% fold-stop now %%\nTail",
    1,
    2,
    true
   ],
   "expected": {
    "stop": null,
    "kind": null
   }
  },
  {
   "name": "marker 23 text before the marker is not a marker",
   "args": [
    "## A\nBody\n\ntext %% fold-stop %%\nTail",
    1,
    2,
    true
   ],
   "expected": {
    "stop": null,
    "kind": null
   }
  },
  {
   "name": "marker 24 an H1 folds past a level 2 marker",
   "args": [
    "# A\nBody\n\n%% fold-stop 2 %%\nTail\n\n---\nEnd",
    1,
    1,
    true
   ],
   "expected": {
    "stop": 7,
    "kind": "rule"
   }
  },
  {
   "name": "marker 25 a marker directly below the heading",
   "args": [
    "# A\n%% fold-stop %%\nTail",
    1,
    1,
    true
   ],
   "expected": {
    "stop": 2,
    "kind": "marker"
   }
  },
