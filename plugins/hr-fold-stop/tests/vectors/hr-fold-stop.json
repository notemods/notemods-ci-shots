 ],
 "editorCases": [
  {
   "name": "Editor edit maps the range without changing the rule",
   "args": [
    "edit",
    "# A\nBody\n\n---\nTail\n# B\nEnd",
    {
     "from": 4,
     "insert": "Added\n"
    }
   ],
   "expected": {
    "text": "# A\nAdded\nBody\n\n---\nTail\n# B\nEnd",
    "folds": [
     [
      3,
      15
     ]
    ],
    "services": 1
   }
  },
  {
   "name": "Unload removes the custom service and keeps the text",
   "args": [
    "unload",
    "# A\nBody\n\n---\nTail\n# B\nEnd",
    null
   ],
   "expected": {
    "text": "# A\nBody\n\n---\nTail\n# B\nEnd",
    "folds": [],
    "services": 0
   }
  },
  {
   "name": "Rule change expands the range and keeps the text",
   "args": [
    "expand",
    "# A\nBody\n\n---\nTail\n# B\nEnd",
    null
   ],
   "expected": {
    "text": "# A\nBody\n\n---\nTail\n# B\nEnd",
    "folds": [],
    "services": 1
   }
  }
 ],
 "markerNote": "End markers. args are text, heading line, heading level and the \"Stop folds at end markers\" setting. foldStopForText returns kind marker for a marker stop.",
 "markerCases": [
  {
   "name": "marker 1 a marker without a digit ends the fold",
   "args": [
    "# A\nBody\n\n%% fold-stop %%\nTail",
    1,
    1,
    true
   ],
   "expected": {
    "stop": 4,
    "kind": "marker"
   }
  },
  {
   "name": "marker 2 a level 4 marker ends the fold of the H4 child",
   "args": [
    "### B\nbody\n#### C\nchild body\n\n%% fold-stop 4 %%\nmore H3 text\n\n---\nTail",
    3,
    4,
    true
   ],
   "expected": {
    "stop": 6,
    "kind": "marker"
   }
  },
  {
   "name": "marker 3 the H3 parent folds past a level 4 marker to the rule",
   "args": [
    "### B\nbody\n#### C\nchild body\n\n%% fold-stop 4 %%\nmore H3 text\n\n---\nTail",
    1,
    3,
    true
   ],
   "expected": {
    "stop": 9,
    "kind": "rule"
   }
  },
  {
   "name": "marker 4 the setting off ignores the marker",
   "args": [
    "# A\nBody\n\n%% fold-stop %%\nTail",
    1,
    1,
    false
   ],
   "expected": {
    "stop": null,
    "kind": null
   }
  },
  {
   "name": "marker 5 the setting off still stops at a rule",
   "args": [
    "# A\nBody\n\n%% fold-stop %%\nTail\n\n---\nEnd",
    1,
    1,
    false
   ],
   "expected": {
    "stop": 7,
    "kind": "rule"
   }
  },
  {
   "name": "marker 6 a marker before a rule wins",
   "args": [
    "# A\nBody\n\n%% fold-stop %%\n\n---\nTail",
    1,
    1,
    true
   ],
   "expected": {
    "stop": 4,
    "kind": "marker"
   }
  },
  {
   "name": "marker 7 a rule before a marker wins",
   "args": [
    "# A\nBody\n\n---\n\n%% fold-stop %%\nTail",
    1,
    1,
    true
   ],
   "expected": {
    "stop": 4,
    "kind": "rule"
   }
  },
  {
   "name": "marker 8 an equal heading before a marker wins",
   "args": [
    "# A\nBody\n# B\n\n%% fold-stop %%\nTail",
    1,
    1,
    true
   ],
   "expected": {
    "stop": 3,
    "kind": "heading"
   }
  },
  {
   "name": "marker 9 a marker in fenced code is not a stop",
   "args": [
    "# A\n```text\n%% fold-stop %%\n```\nBody\n\n---\nTail",
    1,
    1,
    true
   ],
   "expected": {
    "stop": 7,
    "kind": "rule"
   }
  },
  {
   "name": "marker 10 a marker in indented code is not a stop",
   "args": [
    "# A\n\n    %% fold-stop %%\n\nBody\n\n---\nTail",
    1,
    1,
    true
   ],
   "expected": {
    "stop": 7,
    "kind": "rule"
   }
  },
  {
   "name": "marker 11 a marker in frontmatter is not a stop",
   "args": [
    "---\nnote: x\n%% fold-stop %%\n---\n# A\nBody\n# B\nTail",
    5,
    1,
    true
   ],
   "expected": {
    "stop": 7,
    "kind": "heading"
   }
  },
  {
   "name": "marker 12 a marker in a list item is not a stop",
   "args": [
    "# A\n- item\n  %% fold-stop %%\n\n---\nTail",
    1,
    1,
    true
   ],
   "expected": {
    "stop": 5,
    "kind": "rule"
   }
  },
  {
   "name": "marker 13 a marker in a blockquote is not a stop",
   "args": [
    "# A\n> quote\n%% fold-stop %%\n\n---\nTail",
    1,
    1,
    true
   ],
   "expected": {
    "stop": 5,
    "kind": "rule"
   }
  },
  {
   "name": "marker 14 a marker in a callout is not a stop",
   "args": [
    "# A\n> [!note]\n> text\n%% fold-stop %%\n\n---\nTail",
    1,
    1,
    true
   ],
   "expected": {
    "stop": 6,
    "kind": "rule"
   }
  },
  {
   "name": "marker 15 a marker in an open comment block is not a stop",
   "args": [
    "# A\nBody\n\n%%\n%% fold-stop %%\n%%\nMore\n\n---\nTail",
    1,
    1,
    true
   ],
   "expected": {
    "stop": 9,
    "kind": "rule"
   }
  },
  {
   "name": "marker 16 a marker after a closed comment block is a stop",
   "args": [
    "# A\n%%\nhidden\n%%\n\n%% fold-stop %%\nTail",
    1,
    1,
    true
   ],
   "expected": {
    "stop": 6,
    "kind": "marker"
   }
  },
  {
   "name": "marker 17 a comment delimiter in code does not open a comment",
   "args": [
    "# A\n```text\n%%\n```\n\n%% fold-stop %%\nTail",
    1,
    1,
    true
   ],
   "expected": {
    "stop": 6,
    "kind": "marker"
   }
  },
  {
   "name": "marker 18 no spaces inside the delimiters",
   "args": [
    "## A\nBody\n\n%%fold-stop%%\nTail",
    1,
    2,
    true
   ],
   "expected": {
    "stop": 4,
    "kind": "marker"
   }
  },
  {
   "name": "marker 19 upper case marker text",
   "args": [
    "## A\nBody\n\n%% FOLD-STOP %%\nTail",
