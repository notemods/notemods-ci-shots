{
 "slug": "embed-outline",
 "module": "embed-outline/src/outline",
 "function": "buildOutline",
 "note": "args = [notes: path -> Markdown text, the open note path, options {callouts, listHeadings, maxDepth, words, broken}]. Notes are read by tests/scan.ts, which finds headings, embeds, callouts, list items and block IDs as the app's metadata cache does (test/e2e/outline.e2e.ts checks the same rules in the app). expected.lines = outlineLines(items): one row per line, two spaces per level, H<level> heading, E embed, C callout, L<level> heading in a list item, ! broken embed, @ loop; Nw = words; @N = line in the open note that a click scrolls to. An optional fourth argument is the search query. For these cases, filterOutline runs after buildOutline; expected.lines holds the filtered rows and expected.matches holds the number of matching rows without parent rows.",
 "cases": [
  {
   "name": "own headings only, nested by level",
   "args": [
    {
     "Note.md": "# Title\n## One\n### One a\n## Two\n"
    },
    "Note.md",
    {
     "callouts": false,
     "listHeadings": false,
     "maxDepth": 1,
     "words": false,
     "broken": false
    }
   ],
   "expected": {
    "lines": [
     "H1 Title @0",
     "  H2 One @1",
     "    H3 One a @2",
     "  H2 Two @3"
    ],
    "embeds": 0,
    "broken": 0,
    "locked": 0
   }
  },
  {
   "name": "a whole-note embed nests the embedded headings under the embed row",
   "args": [
    {
     "Book.md": "---\ntitle: Book\n---\n# My book\n\n## Part one\n![[Chapter 1]]\n![[Chapter 2]]\n\n## Part two\n![[Chapter 3#Scene B]]\n",
     "Chapters/Chapter 1.md": "# Chapter 1\nThe first words of the book.\n## Scene A\nRain falls on the town.\n",
     "Chapters/Chapter 2.md": "# Chapter 2\nA short chapter with five words.\n",
     "Chapters/Chapter 3.md": "# Chapter 3\n## Scene A\nOne two three.\n## Scene B\nFour five six seven.\n### Beat\nEight.\n## Scene C\nNine.\n"
    },
    "Book.md",
    {
     "callouts": true,
     "listHeadings": true,
     "maxDepth": 1,
     "words": false,
     "broken": false
    }
   ],
   "expected": {
    "lines": [
     "H1 My book @3",
     "  H2 Part one @5",
     "    E Chapter 1 @6",
     "      H1 Chapter 1 @6",
     "        H2 Scene A @6",
     "    E Chapter 2 @7",
     "      H1 Chapter 2 @7",
     "  H2 Part two @9",
     "    E Chapter 3 > Scene B @10",
     "      H2 Scene B @10",
     "        H3 Beat @10"
    ],
    "embeds": 3,
    "broken": 0,
    "locked": 0
   }
  },
  {
   "name": "a heading embed shows that heading and its subheadings only",
   "args": [
    {
     "Host.md": "# Host\n![[Chapter 3#Scene B]]\n",
     "Chapter 3.md": "# Chapter 3\n## Scene A\nOne two three.\n## Scene B\nFour five six seven.\n### Beat\nEight.\n## Scene C\nNine.\n"
    },
    "Host.md",
    {
     "callouts": true,
     "listHeadings": true,
     "maxDepth": 1,
     "words": false,
     "broken": false
    }
   ],
   "expected": {
    "lines": [
     "H1 Host @0",
     "  E Chapter 3 > Scene B @1",
     "    H2 Scene B @1",
     "      H3 Beat @1"
    ],
    "embeds": 1,
    "broken": 0,
    "locked": 0
   }
  },
  {
   "name": "rows of an embedded note scroll to the embed line in the open note",
   "args": [
    {
     "Host.md": "Intro\n\n\n![[A]]\n",
     "A.md": "# A1\ntext\n# A2\n"
    },
    "Host.md",
    {
     "callouts": true,
     "listHeadings": true,
     "maxDepth": 1,
     "words": false,
     "broken": false
    }
   ],
   "expected": {
    "lines": [
     "E A @3",
     "  H1 A1 @3",
     "  H1 A2 @3"
    ],
    "embeds": 1,
    "broken": 0,
    "locked": 0
   }
  },
  {
   "name": "an embed under a heading sits under that heading",
   "args": [
