{
 "slug": "block-drag-links",
 "module": "block-drag-links/src/blocks",
 "function": "findBlock",
 "note": "Each case names its function in fn. findBlock(lines, line) gives the block at a 0-based line (kind, start, end, existing id, heading text) or a refusal. idInsertion(lines, block, id) gives the line and the text to add for a new id. applyInsertion(text, insertion) adds it and keeps every other byte. newBlockId(taken, seq) uses seq as the random source in a loop. headingSubpath, buildLink(generated, subpath, sameNote, embed), readableBlockId (Pro), blocksInRange (Pro) and collectIds. Names that start with a number are spec acceptance cases A1 to A9. Reviewed by hand against each input.",
 "cases": [
  {
   "name": "1 paragraph block spans its lines and keeps its id",
   "fn": "findBlock",
   "args": [
    [
     "Intro line one",
     "line two ^old",
     "",
     "## Plan: next #2 ##",
     "Para after heading",
     "",
     "- item one",
     "  continued text",
     "  - child item ^c1",
     "- [ ] Call Bob",
     "",
     "> quote a",
     "> quote b",
     "",
     "> [!note] Title",
     "> body",
     "",
     "^cal1",
     "",
     "| a | b |",
     "| - | - |",
     "| 1 | 2 |",
     "Next para",
     "",
     "```js",
     "code ^x",
     "```",
     "",
     "$$",
     "x^2",
     "$$",
     ""
    ],
    0
   ],
   "expected": {
    "kind": "paragraph",
    "start": 0,
    "end": 1,
    "id": "old",
    "heading": null
   }
  },
  {
