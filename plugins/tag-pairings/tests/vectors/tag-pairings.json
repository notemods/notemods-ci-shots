{
 "slug": "tag-pairings",
 "module": "tag-pairings/src/pairs",
 "function": "rankPairs",
 "note": "Each case names its function in fn: rankPairs(notes, anchor, exclude, linked, limit, folder) gives the suggested tags best first; triggerAt(text, line, ch) gives the anchor or null; lineTags(line) gives the tag keys of one line; ancestors(key) gives the parents of a nested tag. Names that start with a number are acceptance criteria 1 to 5 of lanes/B7/SPEC.md. Reviewed by hand against each input.",
 "cases": [
  {
   "name": "1 rank by shared notes, ties by total notes then name",
   "fn": "rankPairs",
   "args": [
    {
     "A.md": [
      "book",
      "novel",
      "fiction"
     ],
     "B.md": [
      "book",
      "novel"
     ],
     "C.md": [
      "#book",
      "fiction",
      "Reading"
     ],
     "D.md": [
      "book",
      "history"
     ],
     "E.md": [
      "novel",
      "fiction"
     ],
     "F.md": [
      "Project/Alpha",
      "work"
     ],
     "G.md": [
      "project/beta",
      "work",
      "urgent"
     ],
     "H.md": [
      "project",
      "meeting"
     ],
     "I.md": [
      "project",
      "project/alpha",
      "idea"
     ]
    },
    "book"
   ],
   "expected": [
    {
     "tag": "fiction",
     "display": "fiction",
     "count": 2
    },
    {
     "tag": "novel",
