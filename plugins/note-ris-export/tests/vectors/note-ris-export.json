  {
   "name": "Journal article gives TY TI two AU PY T2 DO and ER with two spaces before the hyphen",
   "function": "buildRis",
   "args": [
    [
     {
      "path": "Refs/Lee 2026.md",
      "props": {
       "type": "JOUR",
       "title": "Test",
       "authors": [
        "Lee",
        "Kim"
       ],
       "year": 2026,
       "journal": "Example",
       "doi": "10.1/test"
      }
     }
    ],
    {
     "type": "type",
     "title": "title",
     "authors": "authors",
     "year": "year",
     "journal": "journal",
     "doi": "doi",
     "url": "url",
     "abstract": "abstract"
    }
   ],
   "expected": {
    "ok": true,
    "count": 1,
    "text": "TY  - JOUR\r\nTI  - Test\r\nAU  - Lee\r\nAU  - Kim\r\nPY  - 2026\r\nT2  - Example\r\nDO  - 10.1/test\r\nER  - \r\n"
   }
  },
