{
 "slug": "bases-multi-edit",
 "module": "bases-multi-edit/src/edit",
 "function": "transform",
 "cases": [
  {
   "name": "set text",
   "args": [
    {
     "exists": true,
     "value": "todo"
    },
    {
     "property": "status",
     "operation": "set",
     "type": "text",
     "input": "done"
    }
   ],
   "expected": {
    "exists": true,
    "value": "done"
   }
  },
  {
   "name": "create number",
   "args": [
    {
     "exists": false
    },
    {
     "property": "status",
     "operation": "set",
     "type": "number",
     "input": "12"
    }
   ],
   "expected": {
    "exists": true,
    "value": 12
   }
  },
  {
   "name": "set checkbox false",
   "args": [
    {
     "exists": true,
     "value": true
    },
    {
     "property": "status",
     "operation": "set",
     "type": "checkbox",
     "input": "false"
    }
   ],
   "expected": {
    "exists": true,
    "value": false
   }
  },
  {
   "name": "append without duplicates",
   "args": [
    {
     "exists": true,
     "value": [
      "a",
      "b"
     ]
    },
    {
     "property": "status",
     "operation": "append",
     "type": "list",
     "input": "[\"b\",\"c\"]"
    }
   ],
   "expected": {
    "exists": true,
    "value": [
     "a",
     "b",
     "c"
    ]
   }
  },
  {
   "name": "append to absent list",
   "args": [
    {
     "exists": false
    },
    {
     "property": "status",
     "operation": "append",
     "type": "list",
     "input": "[\"a\"]"
    }
   ],
   "expected": {
    "exists": true,
    "value": [
     "a"
    ]
   }
  },
  {
   "name": "remove matching list items",
   "args": [
    {
     "exists": true,
     "value": [
      "a",
      "b"
     ]
    },
    {
     "property": "status",
     "operation": "remove-items",
     "type": "list",
     "input": "[\"a\"]"
    }
   ],
   "expected": {
    "exists": true,
    "value": [
     "b"
    ]
   }
  },
  {
   "name": "remove from absent list",
   "args": [
    {
     "exists": false
    },
    {
     "property": "status",
     "operation": "remove-items",
     "type": "list",
     "input": "[\"a\"]"
    }
   ],
   "expected": {
    "exists": false
   }
  },
  {
   "name": "remove property",
   "args": [
    {
     "exists": true,
     "value": [
      "a"
     ]
    },
    {
     "property": "status",
     "operation": "remove-property",
     "type": "text",
     "input": ""
    }
   ],
   "expected": {
    "exists": false
   }
  },
  {
   "name": "empty text remains present",
   "args": [
    {
     "exists": false
    },
    {
     "property": "status",
     "operation": "set",
     "type": "text",
     "input": ""
    }
   ],
   "expected": {
    "exists": true,
    "value": ""
   }
  },
  {
   "name": "preserve list atom types",
   "args": [
    {
     "exists": true,
     "value": [
      false,
      0
     ]
    },
    {
     "property": "status",
     "operation": "append",
     "type": "list",
     "input": "[false,\"0\",null]"
    }
   ],
   "expected": {
    "exists": true,
    "value": [
     false,
     0,
     "0",
     null
    ]
   }
  },
  {
   "name": "append to empty property",
   "args": [
    {
     "exists": true,
     "value": null
    },
    {
     "property": "tags",
     "operation": "append",
     "type": "list",
     "input": "[\"review\"]"
    }
   ],
   "expected": {
    "exists": true,
    "value": [
     "review"
    ]
   }
  },
  {
   "name": "append to scalar property",
   "args": [
    {
     "exists": true,
     "value": "project"
    },
    {
     "property": "tags",
     "operation": "append",
     "type": "list",
     "input": "[\"review\"]"
    }
   ],
   "expected": {
    "exists": true,
    "value": [
     "project",
     "review"
    ]
   }
  },
  {
   "name": "remove from scalar property",
   "args": [
    {
     "exists": true,
     "value": "project"
    },
    {
     "property": "tags",
     "operation": "remove-items",
     "type": "list",
     "input": "[\"project\"]"
    }
   ],
   "expected": {
    "exists": true,
    "value": []
   }
  },
  {
   "name": "remove from empty property",
   "args": [
    {
     "exists": true,
     "value": null
    },
    {
     "property": "tags",
     "operation": "remove-items",
     "type": "list",
     "input": "[\"review\"]"
    }
   ],
   "expected": {
    "exists": true,
    "value": []
   }
  },
  {
   "name": "keep existing duplicates",
   "args": [
    {
     "exists": true,
     "value": [
      "project",
      "project"
     ]
    },
    {
     "property": "tags",
     "operation": "append",
     "type": "list",
     "input": "[\"review\", \"review\"]"
    }
   ],
   "expected": {
    "exists": true,
    "value": [
     "project",
     "project",
     "review"
    ]
   }
  },
  {
   "name": "replace one item in place",
   "args": [
    {
     "exists": true,
     "value": [
      "a",
      "b",
      "c"
     ]
    },
    {
     "property": "tags",
     "operation": "replace-items",
     "type": "list",
     "input": "[\"x\"]",
     "find": "[\"b\"]"
    }
   ],
   "expected": {
    "exists": true,
    "value": [
     "a",
     "x",
     "c"
    ]
   }
  },
  {
   "name": "replace two found items with one",
   "args": [
    {
     "exists": true,
     "value": [
      "a",
      "b",
      "c"
     ]
    },
    {
     "property": "tags",
     "operation": "replace-items",
     "type": "list",
     "input": "[\"x\"]",
     "find": "[\"a\", \"c\"]"
    }
   ],
   "expected": {
    "exists": true,
    "value": [
     "x",
     "b"
    ]
   }
  },
  {
   "name": "replace keeps no duplicate",
   "args": [
    {
     "exists": true,
     "value": [
      "draft",
      "review",
      "done"
     ]
    },
    {
     "property": "tags",
     "operation": "replace-items",
     "type": "list",
     "input": "[\"done\"]",
     "find": "[\"draft\"]"
    }
   ],
   "expected": {
    "exists": true,
    "value": [
     "review",
     "done"
    ]
   }
  },
  {
   "name": "replace no match",
   "args": [
    {
     "exists": true,
     "value": [
      "a",
      "b"
     ]
    },
    {
     "property": "tags",
     "operation": "replace-items",
     "type": "list",
     "input": "[\"x\"]",
     "find": "[\"z\"]"
    }
   ],
   "expected": {
    "exists": true,
    "value": [
     "a",
     "b"
    ]
   }
  },
  {
   "name": "replace absent",
   "args": [
    {
     "exists": false
    },
    {
     "property": "tags",
     "operation": "replace-items",
     "type": "list",
     "input": "[\"x\"]",
     "find": "[\"a\"]"
    }
   ],
   "expected": {
    "exists": false
   }
  },
  {
   "name": "replace null",
   "args": [
    {
     "exists": true,
     "value": null
    },
    {
     "property": "tags",
     "operation": "replace-items",
     "type": "list",
     "input": "[\"x\"]",
     "find": "[\"a\"]"
    }
   ],
   "expected": {
    "exists": true,
    "value": null
   }
  },
  {
   "name": "replace scalar",
   "args": [
    {
     "exists": true,
     "value": "#project"
    },
    {
     "property": "tags",
     "operation": "replace-items",
     "type": "list",
     "input": "[\"project\"]",
     "find": "[\"#project\"]"
    }
   ],
   "expected": {
    "exists": true,
    "value": "project"
   }
  },
  {
   "name": "replace scalar with two items",
   "args": [
    {
     "exists": true,
     "value": "draft"
    },
    {
     "property": "tags",
     "operation": "replace-items",
     "type": "list",
     "input": "[\"review\", \"next\"]",
     "find": "[\"draft\"]"
    }
   ],
   "expected": {
    "exists": true,
    "value": [
     "review",
     "next"
    ]
   }
  },
  {
   "name": "replace one with two in place",
   "args": [
    {
     "exists": true,
     "value": [
      "a",
      "b",
      "c"
     ]
    },
    {
     "property": "tags",
     "operation": "replace-items",
     "type": "list",
     "input": "[\"x\", \"y\"]",
     "find": "[\"b\"]"
    }
   ],
   "expected": {
    "exists": true,
    "value": [
     "a",
     "x",
     "y",
     "c"
    ]
   }
  },
  {
   "name": "replace is typed",
   "args": [
    {
     "exists": true,
     "value": [
      1,
      "1"
     ]
    },
    {
     "property": "tags",
     "operation": "replace-items",
     "type": "list",
     "input": "[2]",
     "find": "[1]"
    }
   ],
   "expected": {
    "exists": true,
    "value": [
     2,
     "1"
    ]
   }
  },
  {
   "name": "replace is case-sensitive outside tags",
   "args": [
    {
     "exists": true,
     "value": [
      "Project",
      "project"
     ]
    },
    {
     "property": "status",
     "operation": "replace-items",
     "type": "list",
     "input": "[\"area\"]",
     "find": "[\"project\"]"
    }
   ],
   "expected": {
    "exists": true,
    "value": [
     "Project",
     "area"
    ]
   }
  },
  {
   "name": "replace keeps old duplicates of kept items",
   "args": [
    {
     "exists": true,
     "value": [
      "k",
      "k",
      "b"
     ]
    },
    {
     "property": "tags",
     "operation": "replace-items",
     "type": "list",
     "input": "[\"x\"]",
     "find": "[\"b\"]"
    }
   ],
   "expected": {
    "exists": true,
    "value": [
     "k",
     "k",
     "x"
    ]
   }
  },
  {
   "name": "replace tags ignores a leading hash",
   "args": [
    {
     "exists": true,
     "value": [
      "#draft",
      "x"
     ]
    },
    {
     "property": "tags",
     "operation": "replace-items",
     "type": "list",
     "input": "[\"done\"]",
     "find": "[\"draft\"]"
    }
   ],
   "expected": {
    "exists": true,
    "value": [
     "done",
     "x"
    ]
   }
  },
  {
   "name": "replace tags finds a hash form",
   "args": [
    {
     "exists": true,
     "value": [
      "draft"
     ]
    },
    {
     "property": "tags",
     "operation": "replace-items",
     "type": "list",
     "input": "[\"#done\"]",
     "find": "[\"#draft\"]"
    }
   ],
   "expected": {
    "exists": true,
    "value": [
     "done"
    ]
   }
  },
  {
   "name": "replace tags ignores letter case",
   "args": [
    {
     "exists": true,
     "value": [
      "Draft"
     ]
    },
    {
     "property": "tags",
     "operation": "replace-items",
     "type": "list",
     "input": "[\"final\"]",
     "find": "[\"draft\"]"
    }
   ],
   "expected": {
    "exists": true,
    "value": [
     "final"
    ]
   }
  },
  {
   "name": "replace tags keeps no duplicate in another form",
   "args": [
    {
     "exists": true,
     "value": [
      "draft",
      "#Done"
     ]
    },
    {
     "property": "tags",
     "operation": "replace-items",
     "type": "list",
     "input": "[\"done\"]",
     "find": "[\"draft\"]"
    }
   ],
   "expected": {
    "exists": true,
    "value": [
     "#Done"
    ]
   }
  },
  {
   "name": "replace tags matches the Tags key spelling",
   "args": [
    {
     "exists": true,
     "value": [
      "#Draft"
     ]
    },
    {
     "property": "Tags",
     "operation": "replace-items",
     "type": "list",
     "input": "[\"done\"]",
     "find": "[\"draft\"]"
    }
   ],
   "expected": {
    "exists": true,
    "value": [
     "done"
    ]
   }
  },
  {
   "name": "replace other list keeps exact hash",
   "args": [
    {
     "exists": true,
     "value": [
      "#draft"
     ]
    },
    {
     "property": "topics",
     "operation": "replace-items",
     "type": "list",
     "input": "[\"done\"]",
     "find": "[\"draft\"]"
    }
   ],
   "expected": {
    "exists": true,
    "value": [
     "#draft"
    ]
   }
  },
  {
   "name": "curly quotes in Find items and Value",
   "args": [
    {
     "exists": true,
     "value": [
      "draft",
      "x"
     ]
    },
    {
     "property": "tags",
     "operation": "replace-items",
     "type": "list",
     "input": "[“done”]",
     "find": "[“draft”]"
    }
   ],
   "expected": {
    "exists": true,
    "value": [
     "done",
     "x"
    ]
   }
  },
  {
   "name": "curly quotes in an append list",
   "args": [
    {
     "exists": true,
     "value": [
      "a"
     ]
    },
    {
     "property": "tags",
     "operation": "append",
     "type": "list",
     "input": "[“review”]"
    }
   ],
   "expected": {
    "exists": true,
    "value": [
     "a",
     "review"
    ]
   }
  },
  {
   "name": "curly quotes inside a valid text item stay",
   "args": [
    {
     "exists": true,
     "value": []
    },
    {
     "property": "tags",
     "operation": "append",
     "type": "list",
     "input": "[\"He said “hi”\"]"
    }
   ],
   "expected": {
    "exists": true,
    "value": [
     "He said “hi”"
    ]
   }
  },
  {
   "name": "curly quote pair inside one item stays one item",
   "args": [
    {
     "exists": true,
     "value": []
    },
    {
     "property": "tags",
     "operation": "append",
     "type": "list",
     "input": "[\"x”, “y\"]"
    }
   ],
   "expected": {
    "exists": true,
    "value": [
     "x”, “y"
    ]
   }
  },
  {
   "name": "curly quoted list still parses",
   "args": [
    {
     "exists": true,
     "value": []
    },
    {
     "property": "tags",
     "operation": "append",
     "type": "list",
     "input": "[“draft”]"
    }
   ],
   "expected": {
    "exists": true,
    "value": [
     "draft"
    ]
   }
  }
 ]
}
