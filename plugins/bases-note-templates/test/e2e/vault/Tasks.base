filters:
  and:
    - file.inFolder("Tasks")
    - status == "todo"
views:
  - type: table
    name: Apollo
    filters:
      and:
        - project == "[[Apollo]]"
    order:
      - file.name
      - status
      - project
      - due
  - type: table
    name: All
    order:
      - file.name
      - status
