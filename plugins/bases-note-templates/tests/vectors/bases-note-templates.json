     "pattern": "{{date:dddd h.mm a}}",
     "now": "2026-10-10T09:30:00"
    },
    {}
   ],
   "expected": {
    "folder": "",
    "name": "Saturday 9.30 am",
    "properties": {},
    "body": ""
   }
  },
  {
   "name": "extra properties merge with filter and template precedence",
   "args": [
    {
     "baseFilters": [],
     "viewFilters": [],
     "order": [],
     "template": "---\nstatus: from-template\n---\nBody",
     "templateName": "Task",
     "pattern": "{{base}} note",
     "folder": "Notes",
     "base": "Book",
     "view": "",
     "now": "2026-10-12T09:30:00",
     "dateFormat": "YYYY-MM-DD",
     "timeFormat": "HH:mm",
     "types": {},
     "extraProps": {
      "status": "from-extra",
      "source": "inbox",
      "created": "{{date:YYYY-MM-DD}}"
     }
    },
    {
