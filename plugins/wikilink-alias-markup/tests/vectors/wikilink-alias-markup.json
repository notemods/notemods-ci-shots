{
 "slug": "wikilink-alias-markup",
 "module": "wikilink-alias-markup/src/markup",
 "function": "parseAlias",
 "note": "Each case names its function in fn. parseAlias(alias, {math}) gives the inline nodes of one alias with offsets in the alias: text, escape, code (open and close backtick counts), math (Pro), and strong, em, del, mark with children. planLine(line, {math}) gives for each aliased wikilink with markup the ranges that Live Preview hides, styles (value = markup type) or draws as math. findAliasLinks(line) gives each aliased wikilink, without embeds and empty aliases. isDefaultText(text, href) is true when the text of a Reading view link is the core text of a link without alias. Names start with the acceptance criterion of lanes/NEW-A/SPEC.md. Reviewed by hand against each input.",
 "cases": [
  {
   "name": "A1 post 1 alias in backticks is inline code",
   "fn": "parseAlias",
   "args": [
    "`obsidian`"
   ],
   "expected": [
    {
     "type": "code",
     "from": 0,
     "to": 10,
     "open": 1,
     "close": 1,
     "text": "obsidian"
    }
   ]
  },
  {
   "name": "A1 post 1 line plans hidden backticks and a code mark",
   "fn": "planLine",
   "args": [
    "[[Obsidian|`obsidian`]]"
   ],
   "expected": [
    {
     "from": 0,
     "to": 23,
     "target": "Obsidian",
     "decos": [
      {
       "kind": "hide",
       "from": 11,
       "to": 12
      },
      {
       "kind": "mark",
       "from": 12,
       "to": 20,
       "value": "code"
      },
      {
       "kind": "hide",
       "from": 20,
       "to": 21
      }
     ]
    }
   ]
  },
  {
   "name": "A1 markup inside code stays text",
   "fn": "parseAlias",
   "args": [
    "`a *b* c`"
   ],
   "expected": [
    {
     "type": "code",
     "from": 0,
     "to": 9,
     "open": 1,
     "close": 1,
     "text": "a *b* c"
    }
   ]
  },
  {
   "name": "A1 double backtick code keeps a single backtick",
   "fn": "parseAlias",
   "args": [
    "`` a`b ``"
   ],
   "expected": [
    {
     "type": "code",
     "from": 0,
     "to": 9,
     "open": 2,
     "close": 2,
     "text": "a`b"
    }
   ]
  },
  {
   "name": "A1 unclosed backtick is text",
   "fn": "parseAlias",
   "args": [
    "`open"
   ],
   "expected": [
    {
     "type": "text",
     "from": 0,
     "to": 5,
     "text": "`open"
    }
   ]
  },
  {
   "name": "A3 post 4 underscore italic on part of the alias",
   "fn": "parseAlias",
   "args": [
    "Knuth's _The TeXbook_"
   ],
   "expected": [
