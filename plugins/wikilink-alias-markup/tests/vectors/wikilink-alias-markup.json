     "math": true
    }
   ],
   "expected": [
    {
     "type": "code",
     "from": 0,
     "to": 5,
     "open": 1,
     "close": 1,
     "text": "$x$"
    }
   ]
  },
  {
   "name": "A9 default text of a link without alias",
   "fn": "isDefaultText",
   "args": [
    "Note",
