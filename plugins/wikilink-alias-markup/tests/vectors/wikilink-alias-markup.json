     "open": 2,
     "close": 2,
     "children": [
      {
       "type": "text",
       "from": 2,
       "to": 6,
       "text": "bold"
      }
     ]
    },
    {
     "type": "text",
     "from": 8,
     "to": 13,
     "text": " and "
    },
    {
     "type": "em",
     "from": 13,
     "to": 17,
     "open": 1,
     "close": 1,
     "children": [
      {
       "type": "text",
       "from": 14,
       "to": 16,
       "text": "it"
      }
     ]
    }
   ]
  },
  {
