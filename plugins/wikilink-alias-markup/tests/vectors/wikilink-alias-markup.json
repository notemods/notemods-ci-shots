     "type": "text",
     "from": 0,
     "to": 8,
     "text": "Knuth's "
    },
    {
     "type": "em",
     "from": 8,
     "to": 21,
     "open": 1,
     "close": 1,
     "children": [
      {
       "type": "text",
       "from": 9,
       "to": 20,
       "text": "The TeXbook"
      }
     ]
    }
   ]
  },
  {
