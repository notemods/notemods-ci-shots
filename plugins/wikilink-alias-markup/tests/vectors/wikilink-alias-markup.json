     "from": 0,
     "to": 9,
     "target": "A",
     "aliasFrom": 4,
     "aliasTo": 7,
     "alias": "`a`"
    },
    {
     "from": 16,
     "to": 25,
     "target": "C",
     "aliasFrom": 20,
     "aliasTo": 23,
     "alias": "*c*"
    }
   ]
  },
  {
   "name": "A12 free keeps math as text",
   "fn": "parseAlias",
   "args": [
    "$NH_3$"
   ],
   "expected": [
    {
     "type": "text",
     "from": 0,
     "to": 6,
     "text": "$NH_3$"
    }
   ]
  },
  {
   "name": "A12 Pro parses math",
   "fn": "parseAlias",
   "args": [
    "$NH_3$ and $x$",
    {
     "math": true
    }
   ],
   "expected": [
    {
     "type": "math",
     "from": 0,
     "to": 6,
     "text": "NH_3"
    },
    {
     "type": "text",
     "from": 6,
     "to": 11,
     "text": " and "
    },
    {
     "type": "math",
