       "kind": "math",
       "from": 11,
       "to": 14,
       "value": "x"
      }
     ]
    }
   ]
  },
  {
   "name": "A12 Pro escaped dollar is text",
   "fn": "parseAlias",
   "args": [
    "\\$x$",
    {
     "math": true
    }
   ],
   "expected": [
    {
     "type": "escape",
     "from": 0,
     "to": 2,
     "text": "$"
    },
    {
     "type": "text",
     "from": 2,
     "to": 4,
     "text": "x$"
