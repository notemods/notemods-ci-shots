     }
    }
   ],
   "expected": [
    {
     "from": 2,
     "to": 14,
     "source": "<%+ 1 + 1 %>",
     "display": "source",
     "text": "<%+ 1 + 1 %>"
    }
   ]
  },
  {
   "name": "A7 owner A uses its own snapshot",
   "args": [
    {
     "path": "A.md",
     "source": "<%+ 1 + 1 %>",
     "enabled": true,
     "live": true,
     "snapshot": {
      "path": "A.md",
      "source": "<%+ 1 + 1 %>",
      "results": [
       {
        "from": 0,
        "to": 12,
        "source": "<%+ 1 + 1 %>",
        "text": "2"
       }
