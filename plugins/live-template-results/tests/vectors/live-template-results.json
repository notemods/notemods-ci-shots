{
 "slug": "live-template-results",
 "module": "live-template-results/src/model",
 "function": "planNote",
 "note": "A1 to A10 map to the acceptance cases. Runtime and mobile checks are separate. These vectors test the render plan, not a script evaluator.",
 "cases": [
  {
   "name": "A1 cached arithmetic result keeps the command range",
   "args": [
    {
     "path": "A.md",
     "source": "<%+ 1 + 1 %>",
     "enabled": true,
     "live": true,
     "snapshot": {
      "path": "A.md",
      "source": "<%+ 1 + 1 %>",
      "results": [
       {
        "from": 0,
        "to": 12,
        "source": "<%+ 1 + 1 %>",
        "text": "2"
       }
      ]
     }
    }
   ],
   "expected": [
    {
     "from": 0,
     "to": 12,
     "source": "<%+ 1 + 1 %>",
     "display": "result",
     "text": "2"
    }
   ]
  },
  {
   "name": "A2 cursor inside shows source",
   "args": [
    {
     "path": "A.md",
     "source": "<%+ 1 + 1 %>",
     "enabled": true,
     "live": true,
     "snapshot": {
      "path": "A.md",
      "source": "<%+ 1 + 1 %>",
      "results": [
       {
        "from": 0,
        "to": 12,
        "source": "<%+ 1 + 1 %>",
        "text": "2"
       }
      ]
     },
     "selections": [
      {
       "from": 4,
       "to": 4
      }
     ]
    }
   ],
   "expected": [
    {
     "from": 0,
     "to": 12,
     "source": "<%+ 1 + 1 %>",
     "display": "source",
     "text": "<%+ 1 + 1 %>"
    }
   ]
  },
  {
   "name": "A2 cursor outside returns the cached result",
   "args": [
    {
     "path": "A.md",
     "source": "<%+ 1 + 1 %>",
     "enabled": true,
     "live": true,
     "snapshot": {
      "path": "A.md",
      "source": "<%+ 1 + 1 %>",
      "results": [
       {
        "from": 0,
        "to": 12,
        "source": "<%+ 1 + 1 %>",
        "text": "2"
       }
      ]
     },
     "selections": []
    }
   ],
   "expected": [
    {
     "from": 0,
     "to": 12,
     "source": "<%+ 1 + 1 %>",
     "display": "result",
     "text": "2"
    }
   ]
  },
  {
   "name": "A3 fenced code is excluded",
   "args": [
    {
     "path": "A.md",
     "source": "```js\n<%+ 1 + 1 %>\n```",
     "enabled": true,
     "live": true
    }
   ],
   "expected": []
  },
  {
   "name": "A3 tilde fence is excluded",
   "args": [
    {
     "path": "A.md",
     "source": "~~~\n<%+ 1 + 1 %>\n~~~",
     "enabled": true,
     "live": true
    }
   ],
   "expected": []
  },
  {
   "name": "A3 inline code is excluded",
   "args": [
    {
     "path": "A.md",
     "source": "`<%+ 1 + 1 %>`",
     "enabled": true,
     "live": true
    }
   ],
   "expected": []
  },
  {
   "name": "A3 frontmatter is excluded",
   "args": [
    {
     "path": "A.md",
     "source": "---\nvalue: <%+ 1 + 1 %>\n---",
     "enabled": true,
     "live": true
    }
   ],
   "expected": []
  },
  {
   "name": "A4 disabled note has no render plan",
   "args": [
    {
     "path": "A.md",
     "source": "<%+ 1 + 1 %>",
     "enabled": false,
     "live": true,
     "snapshot": {
      "path": "A.md",
      "source": "<%+ 1 + 1 %>",
      "results": [
       {
        "from": 0,
        "to": 12,
        "source": "<%+ 1 + 1 %>",
        "text": "2"
       }
      ]
     }
    }
   ],
   "expected": []
  },
  {
   "name": "A5 no host result keeps source editable",
   "args": [
    {
     "path": "A.md",
     "source": "<%+ 1 + 1 %>",
     "enabled": true,
     "live": true
    }
   ],
   "expected": [
    {
     "from": 0,
     "to": 12,
     "source": "<%+ 1 + 1 %>",
     "display": "source",
     "text": "<%+ 1 + 1 %>"
    }
   ]
  },
  {
   "name": "A5 render error keeps a source range and error",
   "args": [
    {
     "path": "A.md",
     "source": "<%+ 1 + 1 %>",
     "enabled": true,
     "live": true,
     "snapshot": {
      "path": "A.md",
      "source": "<%+ 1 + 1 %>",
      "results": [
       {
        "from": 0,
        "to": 12,
        "source": "<%+ 1 + 1 %>",
        "error": "No result produced."
       }
      ]
     }
    }
   ],
   "expected": [
    {
     "from": 0,
     "to": 12,
     "source": "<%+ 1 + 1 %>",
     "display": "error",
     "text": "No result produced."
    }
   ]
  },
  {
   "name": "A6 changed command rejects old snapshot",
   "args": [
    {
     "path": "A.md",
     "source": "<%+ 2 + 2 %>",
     "enabled": true,
     "live": true,
     "snapshot": {
      "path": "A.md",
      "source": "<%+ 1 + 1 %>",
      "results": [
       {
        "from": 0,
        "to": 12,
        "source": "<%+ 1 + 1 %>",
        "text": "2"
       }
      ]
     }
    }
   ],
   "expected": [
    {
     "from": 0,
     "to": 12,
     "source": "<%+ 2 + 2 %>",
     "display": "source",
     "text": "<%+ 2 + 2 %>"
    }
   ]
  },
  {
   "name": "A6 deleted command rejects old snapshot",
   "args": [
    {
     "path": "A.md",
     "source": "",
     "enabled": true,
     "live": true,
     "snapshot": {
      "path": "A.md",
      "source": "<%+ 1 + 1 %>",
      "results": [
       {
        "from": 0,
        "to": 12,
        "source": "<%+ 1 + 1 %>",
        "text": "2"
       }
      ]
     }
    }
   ],
   "expected": []
  },
  {
   "name": "A6 inserted prefix rejects old offsets",
   "args": [
    {
     "path": "A.md",
     "source": "X <%+ 1 + 1 %>",
     "enabled": true,
     "live": true,
     "snapshot": {
      "path": "A.md",
      "source": "<%+ 1 + 1 %>",
      "results": [
       {
        "from": 0,
        "to": 12,
        "source": "<%+ 1 + 1 %>",
        "text": "2"
