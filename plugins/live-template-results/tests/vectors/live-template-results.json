     }
    }
   ],
   "expected": [
    {
     "from": 0,
     "to": 12,
     "source": "<%+ 1 + 1 %>",
     "display": "result",
     "text": "2"
    }
   ]
  },
  {
   "name": "A7 owner B rejects owner A snapshot",
   "args": [
    {
     "path": "B.md",
     "source": "<%+ 1 + 1 %>",
     "enabled": true,
     "live": true,
     "snapshot": {
      "path": "A.md",
      "source": "<%+ 1 + 1 %>",
      "results": [
       {
        "from": 0,
        "to": 12,
        "source": "<%+ 1 + 1 %>",
        "text": "2"
       }
      ]
     }
    }
   ],
   "expected": [
    {
     "from": 0,
     "to": 12,
     "source": "<%+ 1 + 1 %>",
     "display": "source",
     "text": "<%+ 1 + 1 %>"
    }
   ]
  },
  {
   "name": "A8 two commands keep source order",
   "args": [
    {
     "path": "A.md",
     "source": "<%+ 1 + 1 %> <%+ 1 + 1 %>",
     "enabled": true,
     "live": true,
     "snapshot": {
      "path": "A.md",
      "source": "<%+ 1 + 1 %> <%+ 1 + 1 %>",
      "results": [
       {
        "from": 0,
        "to": 12,
        "source": "<%+ 1 + 1 %>",
        "text": "2"
       },
       {
        "from": 13,
        "to": 25,
        "source": "<%+ 1 + 1 %>",
        "text": "2"
       }
      ]
     }
    }
   ],
   "expected": [
    {
     "from": 0,
     "to": 12,
     "source": "<%+ 1 + 1 %>",
     "display": "result",
     "text": "2"
    },
    {
     "from": 13,
     "to": 25,
     "source": "<%+ 1 + 1 %>",
     "display": "result",
     "text": "2"
    }
   ]
  },
  {
   "name": "A9 disable removes a failed render",
   "args": [
    {
     "path": "A.md",
     "source": "<%+ 1 + 1 %>",
     "enabled": false,
     "live": true,
     "snapshot": {
      "path": "A.md",
